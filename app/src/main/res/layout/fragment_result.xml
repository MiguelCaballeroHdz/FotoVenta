<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_result"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/image_car"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/text_ad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:textSize="16sp" />

    <Button android:id="@+id/button_share_whatsapp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/share_whatsapp" />
    <Button android:id="@+id/button_copy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy" />
    <Button android:id="@+id/button_save_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_image" />
</LinearLayout>
